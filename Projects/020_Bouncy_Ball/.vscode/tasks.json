{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "make build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build (Release)",
            "type": "shell",
            "command": "make build BUILD=release",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Analyze",
            "type": "shell",
            "command": "make analyze",
            "problemMatcher": []
        },
        {
            "label": "All (Build + Analyze)",
            "type": "shell",
            "command": "make all",
            "problemMatcher": []
        },
        {
            "label": "Format Apply",
            "type": "shell",
            "command": "make format",
            "problemMatcher": []
        },
        {
            "label": "Format Check",
            "type": "shell",
            "command": "make format-check",
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        }
    ]
}
